{
	"name": "@artifex/hive-pi",
	"version": "0.1.0",
	"type": "module",
	"description": "The public pi harness foundation that ships with Hive: extensions, subagent roles, prompt templates and themes.",
	"license": "MIT",
	"keywords": [
		"pi-package"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Artifex-org/hive-pi.git"
	},
	"pi": {
		"extensions": [
			"./extensions"
		],
		"prompts": [
			"./prompts"
		],
		"themes": [
			"./themes"
		]
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check": "npm run typecheck && npm run test",
		"eval": "node evals/runner/run.ts",
		"eval:compare": "EVAL_MODE=compare node evals/runner/run.ts"
	},
	"dependencies": {
		"@mozilla/readability": "^0.6.0",
		"asciichart": "1.5.25",
		"linkedom": "^0.18.12",
		"playwright-core": "1.62.1",
		"unpdf": "^1.3.2"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-agent-core": {
			"optional": true
		},
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "0.84.2",
		"@earendil-works/pi-ai": "0.84.2",
		"@earendil-works/pi-coding-agent": "0.84.2",
		"@earendil-works/pi-tui": "0.84.2",
		"@types/node": "24.12.4",
		"typebox": "1.3.7",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"homepage": "https://github.com/Artifex-org/hive-pi",
	"bugs": {
		"url": "https://github.com/Artifex-org/hive-pi/issues"
	}
}
