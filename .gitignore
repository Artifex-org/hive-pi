node_modules/
*.log
.DS_Store

# Defence in depth for a public repo: a stranger cloning this and working in it
# must not be one `git add -A` away from publishing their own credentials.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
auth.json
.npmrc
credentials.json

# Handoff seeds (`/handoff`, HIV-1231). Consumed seeds are RENAMED rather than
# deleted so lineage stays on disk, which leaves them untracked in the worktree
# where a later `git add -A` would commit them. A seed carries branch names,
# PR/ticket ids, knowledge paths and open work items — internal state that must
# not reach a public repo by accident.
.pi/handoff*
